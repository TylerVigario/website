{
  "name": "vigario-technology-solutions",
  "version": "1.6.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "next build",
    "build:server": "tsx scripts/build-server.ts",
    "check:env-templates": "tsx scripts/check-env-templates.ts",
    "ci": "npm run lint && npm run typecheck && npm run format && npm test && npm run check:env-templates",
    "clean": "node -e \"const fs=require('fs'); ['.next','server.js','node_modules/.cache','.eslintcache'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "dev": "next dev",
    "dev:server": "tsx server.ts",
    "email:dev": "email dev --dir src/emails --port 3001",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint:js && npm run lint:md",
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "postbuild": "tsx scripts/postbuild.ts",
    "prebuild": "npm run check:env-templates && npm run build:server",
    "prepare": "husky",
    "start": "node server.js",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.53.1",
    "better-sqlite3": "^12.10.0",
    "next": "^16.2.6",
    "nodemailer": "^8.0.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "react-email": "^6.1.4",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
