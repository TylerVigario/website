{
  "name": "vigario-technology-solutions",
  "version": "1.19.1",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "astro build",
    "check:bundles": "node scripts/check-bundles.ts",
    "check:forms": "node scripts/check-forms.ts",
    "check:release": "node scripts/check-release.ts",
    "ci": "npm run check:install-scripts && npm run lint && npm run typecheck && npm run format && npm test && npm run build && npm run check:bundles && npm run check:forms",
    "clean": "node -e \"const fs=require('fs'); ['dist','.astro','node_modules/.cache','.eslintcache'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "dev": "node --env-file-if-exists=.env.local node_modules/astro/bin/astro.mjs dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint:js && npm run lint:md && npm run lint:actions",
    "lint:actions": "node scripts/lint-actions.ts",
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "preview": "node --env-file-if-exists=.env.local node_modules/astro/bin/astro.mjs preview",
    "release": "node scripts/make-release.ts",
    "start": "node --env-file-if-exists=.env.local ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "check:pins": "node scripts/check-node-pins.ts",
    "check:install-scripts": "node scripts/check-install-scripts.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "better-sqlite3": "^13.0.3",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "browserslist": "^4.29.5",
    "caniuse-lite": "^1.0.30001815",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "git-cliff": "^2.14.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.astro": [
      "eslint --cache --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,js}": [
      "eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{json,jsonc,css}": [
      "prettier --write"
    ],
    "*.{yml,yaml}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 0.2%",
    "not dead",
    "not op_mini all",
    "not and_uc > 0",
    "not op_mob > 0",
    "not chrome < 111",
    "not firefox < 128",
    "not safari < 16.4",
    "not ios_saf < 16.4"
  ],
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild": false,
    "fsevents": false
  }
}
