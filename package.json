{
  "name": "vigario-technology-solutions",
  "version": "1.10.1",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "astro build",
    "check:bundles": "node scripts/check-bundles.mjs",
    "ci": "npm run lint && npm run typecheck && npm run format && npm test && npm run build && npm run check:bundles",
    "clean": "node -e \"const fs=require('fs'); ['dist','.astro','node_modules/.cache','.eslintcache'].forEach(p=>fs.rmSync(p,{recursive:true,force:true}))\"",
    "dev": "astro dev",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "npm run lint:js && npm run lint:md",
    "lint:js": "eslint",
    "lint:js:fix": "eslint --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "prepare": "husky",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "better-sqlite3": "^13.0.3",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.12.4",
    "@types/nodemailer": "^8.0.0",
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001809",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.astro": [
      "eslint --cache --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,js,mjs}": [
      "eslint --cache --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ],
    "*.{json,jsonc,css}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "> 0.2%",
    "not dead",
    "not op_mini all",
    "not and_uc > 0",
    "not op_mob > 0",
    "not chrome < 111",
    "not firefox < 128",
    "not safari < 16.4",
    "not ios_saf < 16.4"
  ]
}
