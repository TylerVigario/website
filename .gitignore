# Dependencies. npm only — package.json pins packageManager and the
# lockfile is package-lock.json, so yarn/pnp entries would be noise.
/node_modules

# Astro build output and generated types. Both were tracked at some
# point, which is how build artefacts reached history; gitignore does
# not apply to an already-tracked path, so they had to be git rm --cached.
/dist
/.astro

# Environment. Values are secrets; the example is the contract.
.env*
!.env.example

# SQLite. Path comes from SQLITE_PATH; the dev convention is ./data/.
/data
*.db
*.db-journal
*.db-shm
*.db-wal

# Tool caches
*.tsbuildinfo
.eslintcache

# OS noise
.DS_Store

# Claude Code per-developer overrides (settings.json stays tracked)
.claude/settings.local.json
