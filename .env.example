# Local dev: copy this file to .env.local. Next.js loads .env.local
# automatically for `next dev` and `next build`. Production reads its
# environment from /opt/website/.env (managed by the prod-side deploy
# script, not this repo).

# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

# Absolute path to the SQLite database file. Stored outside any
# release directory in production so the data survives release swaps.
# Dev convention: ./data/quotes.db (the data/ dir is gitignored).
SQLITE_PATH=./data/quotes.db

# ---------------------------------------------------------------
# Optional — quote / POTS-audit email notifications
# ---------------------------------------------------------------
# When SMTP_USER + SMTP_PASS are both set, the API routes send an
# email notification on each submission. When unset, submissions are
# saved to SQLite but no email is sent (the route degrades gracefully).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
