# Local dev: copy this file to .env.local. `npm run dev`, `npm run preview`
# and `npm start` load it into process.env (Node's --env-file-if-exists).
# Astro itself does not, so `astro dev` run directly leaves these unset.
#
# In production these are supplied by whatever runs the process, and no
# .env file is read. SQLITE_PATH is checked when the database is first
# opened (the first submission or health check), not at startup; the
# static pages serve either way, which is why a deploy should check
# /api/health rather than a listening port.

# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

# Absolute path to the SQLite database file. Validated on first open by
# getDbPath() in src/lib/db.ts, which rejects relative paths outright:
# a relative path resolves against the process working directory,
# which is not something the app controls, so the same config would
# mean different files depending on how the process was started.
#
# Keep it outside any release directory so the data survives a deploy.
#
# Dev: any absolute path on your machine, e.g.
#   /home/<you>/src/website/data/quotes.db
# The data/ dir is gitignored; create it once with mkdir.
SQLITE_PATH=

# ---------------------------------------------------------------
# Optional — where the server listens
# ---------------------------------------------------------------
# Read by @astrojs/node itself, not by application code. Unset, it
# listens on localhost:4321, which is what you want behind a reverse
# proxy — the process is not directly reachable from the network.
#
# Set HOST=0.0.0.0 only to expose it deliberately.
#
# Note these names: the adapter reads HOST, not HOSTNAME. Setting
# HOSTNAME does nothing at all, silently.

# HOST=127.0.0.1
# PORT=4321

# ---------------------------------------------------------------
# Optional — health
# ---------------------------------------------------------------
# /api/health answers 503 when free space where the database lives drops
# under this many megabytes, so a monitor hears about a filling disk
# before submissions start failing on it. Default 64; 0 turns the check
# off. A value that is not a number fails the check rather than being
# ignored.
#HEALTH_MIN_FREE_MB=64

# ---------------------------------------------------------------
# Optional — submission notification emails
# ---------------------------------------------------------------
# Every submission is saved to SQLite and answered whether or not mail is
# configured — the email is an extra, never a precondition, so a broken
# mail server cannot cost a lead.
#
# Three states. Nothing below set: mail is off, and each send is logged
# as "would send". Anything set: mail is on, exactly as written, and the
# mode in use is logged once at boot. Something set that cannot be acted
# on as written (half a pair of credentials, an unknown TLS mode): mail
# is off and the boot log says why, loudly.
#
# Any relay works — authenticated or not, on this machine, on the LAN or
# remote:
#
#   authenticated:   SMTP_HOST=smtp.gmail.com SMTP_USER=… SMTP_PASS=…
#   this machine:    SMTP_HOST=localhost SMTP_PORT=25 SMTP_FROM=… NOTIFY_EMAIL=…
#   LAN, plaintext:  SMTP_HOST=relay.lan SMTP_PORT=25 SMTP_TLS=none SMTP_FROM=… NOTIFY_EMAIL=…
#
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=

# How the relay is reached. Unset, the default follows the relay:
# implicit TLS on port 465, no TLS for localhost, and required STARTTLS
# for anything else. Set, it is honoured for any host.
#
#   implicit   TLS from the first byte (port 465 unless SMTP_PORT says otherwise)
#   starttls   STARTTLS, required: refuses to continue in plaintext if the
#              relay does not offer it (port 587 unless SMTP_PORT says otherwise)
#   none       plaintext
#
# `none`, or SMTP_TLS_VERIFY=false, leaves the relay unauthenticated. That
# is yours to choose; the only comment the app makes is a boot warning
# when the relay resolves to an address outside the loopback, private
# and link-local ranges.
#SMTP_TLS=

# Whether the relay's certificate is checked. Default true. For a relay
# with a self-signed or private-CA certificate, NODE_EXTRA_CA_CERTS
# (Node's own setting: a path to a PEM file) keeps the check and trusts
# that certificate instead of turning verification off.
#SMTP_TLS_VERIFY=true

# How long each phase of a send may take — connecting, the greeting, and
# any silence mid-conversation — in milliseconds. Default 10000. The send
# is awaited before the form gets its answer, so this bounds how long a
# stalled relay can hold a submission.
#SMTP_TIMEOUT_MS=10000

# Envelope sender. Defaults to SMTP_USER, which only exists when the
# relay authenticates — an unauthenticated relay must state it.
#SMTP_FROM=noreply@example.com

# Where submission notifications land. Defaults to SMTP_USER — mail sent
# through your own relay, back to you — so it only needs setting when the
# recipient differs from the sending account, or the relay does not
# authenticate.
#NOTIFY_EMAIL=
