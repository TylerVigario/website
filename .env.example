# Local dev: copy this file to .env.local. Next.js loads .env.local
# automatically for `next dev` and `next build`. In production these
# values are set by whatever the deployment env mechanism is — see
# docs/deployment.md for the current shape.

# ---------------------------------------------------------------
# Required
# ---------------------------------------------------------------

# Absolute path to the SQLite database file. Validated at server
# startup by src/lib/runtime-config.ts — relative paths are rejected
# (they depend on the process cwd and break under systemd). Stored
# outside any release directory in production so the data survives
# release swaps.
#
# Dev: pick an absolute path on your machine. Suggested:
#   /home/<you>/Projects/website/data/quotes.db   (Linux/macOS)
#   C:\Users\<you>\Projects\website\data\quotes.db   (Windows)
# The data/ dir is gitignored; create it once with mkdir.
SQLITE_PATH=

# ---------------------------------------------------------------
# Optional — quote / POTS-audit email notifications
# ---------------------------------------------------------------
# When SMTP_USER + SMTP_PASS are both set, the API routes send an
# email notification on each submission. When unset, submissions are
# saved to SQLite but no email is sent (the route degrades gracefully).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------
# Optional — Sentry error / performance monitoring
# ---------------------------------------------------------------
# SENTRY_DSN drives the server-side init (src/sentry.server.config.ts).
# NEXT_PUBLIC_SENTRY_DSN is inlined into the client bundle at build
# time and drives the browser init (src/instrumentation-client.ts).
# When unset, Sentry init is a no-op and the app runs normally.
#
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN are read by
# `withSentryConfig` at build time to upload source maps so production
# stack traces resolve back to readable TS. Without them the build
# still succeeds but stack traces in Sentry stay minified.

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
