---
import Base from "@/layouts/Base.astro";
import POTSLanding from "@/components/POTSLanding.astro";
import LandingHeader from "@/components/LandingHeader.astro";
import { readSubmission, submitPotsAudit, type Values } from "@/lib/api/submit";

// Built from Astro.site so the canonical domain lives in one place.
const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site}/pots-migration#service`,
  name: "POTS to VoIP Migration",
  description:
    "Telecom audit, VoIP migration, and carrier dispute advocacy for small businesses still on legacy copper landlines.",
  url: `${site}/pots-migration`,
  provider: {
    "@type": "ProfessionalService",
    "@id": `${site}/#business`,
    name: "Vigario Technology Solutions",
    telephone: "+1-559-900-1400",
    email: "contact@vigario.tech",
    areaServed: [
      { "@type": "City", name: "Fresno" },
      { "@type": "City", name: "Clovis" },
      { "@type": "City", name: "Madera" },
      { "@type": "City", name: "Visalia" },
      { "@type": "GeoShape", name: "Central Valley, CA" },
    ],
  },
  serviceType: [
    "Telecom Audit",
    "VoIP Migration",
    "Carrier Dispute Advocacy",
    "POTS Line Replacement",
  ],
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free telecom audit",
  },
};

// Accepts input, so it renders per request like /contact: this page
// takes the audit form's no-JS submit, below.
export const prerender = false;

// These responses can carry what someone typed: a submit that fails
// validation is re-rendered with the values echoed back into the form,
// so the HTML contains a real person's name, contact details and
// message. Nothing may store that: not a browser cache a shared machine
// can be walked up to, not an intermediary, not the back button
// restoring it for whoever is next.
//
// no-store rather than no-cache — no-cache permits storage as long as
// the cache revalidates, which is the wrong answer when the objection
// is the storing itself.
Astro.response.headers.set("Cache-Control", "no-store");

// The no-JS submit lands here, posted by the form to its own page. It
// used to go to the API, which redirected back with everything typed in
// the query string: that put names and messages into browser history and
// access logs, failed outright once the text outgrew a request line, and
// let anyone put words in the form's alert box through a crafted link.
// Now a failure re-renders this page, 422, with every value still in the
// form, and nothing typed is ever in a URL. Success redirects, so a
// reload cannot submit twice. The work is submitPotsAudit(), the same function
// the JSON API calls.
let values: Values = {};
let errors: Record<string, string> = {};
if (Astro.request.method === "POST") {
  const outcome = await submitPotsAudit(await readSubmission(Astro.request));
  if (outcome.kind !== "invalid") return Astro.redirect("/pots-migration?sent=1#audit", 303);
  ({ values, errors } = outcome);
  Astro.response.status = 422;
}
const submitted = Astro.url.searchParams.get("sent") === "1";
---

<Base title="POTS to VoIP Migration | Stop Overpaying for Landline Service" description="Still on AT&T or Verizon copper landlines? Your carrier is charging you 5-20x what modern VoIP costs. Free telecom audit for Central Valley businesses." jsonLd={jsonLd} mainClass="pt-16">
  <LandingHeader slot="header" />
  <POTSLanding values={values} errors={errors} submitted={submitted} />
</Base>
