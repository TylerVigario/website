---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import ServiceIcon from "@/components/ServiceIcon.astro";
import { services } from "@/lib/services";

// Built from Astro.site so the canonical domain lives in one place.
const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site}/services#service`,
  name: "IT Services",
  description:
    "Full-stack IT services — networking, security cameras, Windows & Linux systems, cabling, custom software, and IT strategy.",
  url: `${site}/services`,
  provider: {
    "@type": "ProfessionalService",
    "@id": `${site}/#business`,
  },
  serviceType: [
    ...services.map((s) => s.title),
    "Windows Systems Management",
    "Linux Server Administration",
  ],
  areaServed: [
    { "@type": "City", name: "Fresno" },
    { "@type": "City", name: "Clovis" },
    { "@type": "City", name: "Visalia" },
    { "@type": "GeoShape", name: "Central Valley, CA" },
  ],
};

/* Featured service pages — these have dedicated pages */
const featured = [
  {
    title: "Network Engineering",
    desc: "Design, deployment, and troubleshooting. WiFi, switching, routing, firewalls, VPNs, cabling — the full stack.",
    href: "/services/networking",
    slug: "networking",
  },
  {
    title: "Security Cameras",
    desc: "Local AI detection with Frigate NVR. No cloud subscriptions, no monthly fees. Reliable, private, and affordable.",
    href: "/services/security-cameras",
    slug: "security-cameras",
  },
  {
    title: "Windows Systems",
    desc: "Deployment, management, and app support for desktops and servers. Active Directory, Group Policy, patching — if it runs on Windows, I handle it.",
    href: "/services/windows",
    slug: "windows",
  },
  {
    title: "Linux Systems",
    desc: "Server deployment, configuration, and maintenance. Web servers, Docker, networking appliances, storage — CLI-driven, no bloat.",
    href: "/services/linux",
    slug: "linux",
  },
];

/* General services — no dedicated page yet */
const general = services.filter(
  (s) =>
    !["Networking & WiFi", "Security & Cameras", "Computers, Servers & Cloud"].includes(s.title),
);
---

<Base title="IT Services" description="Full-stack IT in Fresno, CA — networking, security cameras, Windows and Linux, cabling, and custom software. Transparent hourly rate, no retainers." jsonLd={jsonLd}>
  <Nav />

    <>
      {/* Header */}
      <section class="pt-32 pb-16 lg:pb-20 lg:pt-36">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <h1 class="text-3xl font-bold tracking-tight text-navy sm:text-4xl md:text-5xl">
              You know the cost upfront.
            </h1>
            <p class="mt-4 max-w-xl text-lg text-muted">
              Transparent hourly rate, no retainers, no surprises. We&apos;ll scope it before we
              start &mdash; whether it&apos;s a full network buildout or just getting your WiFi
              working again.
            </p>
          </div>

          {/* Featured services — have dedicated pages */}
          <div class="mt-12 grid gap-6 sm:grid-cols-2">
            {featured.map((s) => (
              <div data-reveal>
                <a
                  href={s.href}
                  class="group flex h-full flex-col rounded-2xl border border-border bg-surface-light p-6 transition-all sm:p-8 hover:border-accent/30 hover:-translate-y-1 hover:shadow-lg"
                >
                  <div class="mb-5 inline-flex rounded-xl bg-accent-soft p-3 text-accent">
                    <ServiceIcon slug={s.slug} />
                  </div>
                  <h2 class="mb-3 text-xl font-semibold text-navy">{s.title}</h2>
                  <p class="leading-relaxed text-muted">{s.desc}</p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
                    Learn more
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* General services — link to contact */}
      <section class="bg-surface py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <h2 class="text-2xl font-bold tracking-tight text-navy sm:text-4xl">
              Also available
            </h2>
          </div>
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {general.map((s) => (
              <div data-reveal>
                <a
                  href={`/contact?service=${encodeURIComponent(s.title)}`}
                  class="group flex h-full flex-col rounded-2xl border border-border bg-surface-light p-6 transition-all sm:p-8 hover:border-accent/30 hover:-translate-y-1 hover:shadow-lg"
                >
                  <div class="mb-5 inline-flex rounded-xl bg-accent-soft p-3 text-accent">
                    <ServiceIcon slug={s.slug} />
                  </div>
                  <h2 class="mb-3 text-xl font-semibold text-navy">{s.title}</h2>
                  <p class="leading-relaxed text-muted">{s.desc}</p>
                  <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent opacity-0 transition-opacity group-hover:opacity-100">
                    Get a quote
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 20 20"
                      fill="currentColor"
                      class="h-4 w-4"
                      aria-hidden="true"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </span>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CTA */}
      <section class="py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <div class="mx-auto max-w-3xl text-center">
              <h2 class="text-2xl font-bold tracking-tight text-navy sm:text-4xl">
                We&apos;re not a vendor. We&apos;re builders.
              </h2>
              <p class="mt-4 text-lg text-muted leading-relaxed">
                Most IT shops don&apos;t write software, and most dev shops don&apos;t pull cable.
                We do both. Every project is founder-led &mdash; no rotating contractors, no ticket
                queues, no runaround.
              </p>
              <div class="mt-8">
                <a
                  href="/contact"
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-base font-semibold text-white transition-all hover:bg-accent-bright hover:shadow-lg hover:shadow-accent/15"
                >
                  Get a free quote
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </>
  <Footer />
</Base>
