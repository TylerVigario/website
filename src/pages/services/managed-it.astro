import ServicePage from "@/components/ServicePage.astro";

const capabilities = [
  {
    title: "Monitoring & Support",
    items: [
      "Remote management of every workstation and register",
      "Updates and patches, kept current",
      "Help from people who already know your setup",
      "On-site visits across the Central Valley",
      "New machines set up and old ones retired",
      "Documentation of what you have and how it fits",
    ],
  },
  {
    title: "Backups You Can Trust",
    items: [
      "Scheduled backups of the data that runs the business",
      "Each backup checksummed and verified before it goes off-site",
      "Off-site copies on hardware we run",
      "An alert when a backup fails to arrive",
      "Regular integrity checks of your databases",
      "A recovery plan written down before it's needed",
    ],
  },
  {
    title: "Phones, Email & Accounts",
    items: [
      "VoIP phones, with your numbers ported over",
      "Business email on your own domain",
      "SPF, DKIM and DMARC, so your mail arrives",
      "Accounts and devices for new staff",
      "Carrier and vendor bills reviewed",
      "Planning for what to replace, and when",
    ],
  },
];

const examples = [
  {
    title: "Bravo Farms",
    status: "Client since 2021",
    desc: "Two stores, sixteen machines managed remotely, register backups verified before they go off-site, and phones, the online store and the paperwork looked after.",
    href: "/work/bravo-farms",
  },
  {
    title: "POTS-to-VoIP Migration",
