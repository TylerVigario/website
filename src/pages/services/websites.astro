import ServicePage from "@/components/ServicePage.astro";

const capabilities = [
  {
    title: "Design & Build",
    items: [
      "Designed around your business, not a template",
      "Built for phones first, and fast on them",
      "Accessible to people using screen readers and keyboards",
      "Contact and quote forms that reach you",
      "Copy written with you, in your words",
      "Google Business Profile and search basics",
    ],
  },
  {
    title: "Hosting",
    items: [
      "Hosted on servers we own and run",
      "HTTPS, security headers and a web application firewall",
      "Domain and DNS management",
