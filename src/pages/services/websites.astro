      "Nightly backups",
      "Changes made by the people who built it",
    ],
  },
  {
    title: "Beyond the Brochure",
    items: [
      "Booking and quote requests",
      "A back office for editing your own content",
      "Mailing lists you own, not rent",
      "Downloads, catalogs and printable documents",
      "Connections to the tools you already use",
      "Room to grow into custom software",
    ],
  },
];

const examples = [
  {
    title: "iTaleSoWell",
    status: "Live",
    desc: "An author's site: twenty stories with cover art and an ePub each, a reader built for phones, a mailing list, and the back office the author runs it all from.",
    href: "/work/italesowell",
  },
  {
    title: "vigario.tech",
