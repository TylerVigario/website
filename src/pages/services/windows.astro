---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

// Built from Astro.site so the canonical domain lives in one place.
const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${site}/services/windows#service`,
  name: "Windows Systems Management",
  description: "Windows deployment, management, and application support for desktops and servers.",
  url: `${site}/services/windows`,
  provider: {
    "@type": "ProfessionalService",
    "@id": `${site}/#business`,
  },
  serviceType: [
    "Windows Server Administration",
    "Windows Desktop Deployment",
    "Active Directory Management",
    "Windows Application Support",
  ],
};

const capabilities = [
  {
    title: "Deployment & Setup",
    items: [
      "Clean OS installs and imaging",
      "Domain join and Active Directory setup",
      "Group Policy configuration",
      "User account provisioning",
      "Driver and peripheral setup",
      "Encryption and security hardening",
    ],
  },
  {
    title: "Ongoing Management",
    items: [
      "Windows Update and patch management",
      "Performance monitoring and tuning",
      "Backup configuration and verification",
      "Antivirus and endpoint security",
      "Remote management and access setup",
      "Hardware lifecycle planning",
    ],
  },
  {
    title: "Application Support",
    items: [
      "Line-of-business app installation and config",
      "Microsoft 365 and Office deployment",
      "Printer and scanner setup",
      "Application crashes and compatibility issues",
      "Database and POS system support",
      "Custom scripting and automation",
    ],
  },
];
---

<Base title="Windows Systems" description="Windows deployment, management, and support for small businesses in Fresno, CA. Workstations, servers, Active Directory, Group Policy, and patching." jsonLd={jsonLd}>
  <Nav />

    <>
      {/* Hero */}
      <section class="pt-32 pb-16 lg:pb-20 lg:pt-36">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <p class="text-sm font-medium text-accent">
              <a href="/services" class="hover:text-accent-bright transition-colors">
                Services
              </a>
              {" / "}
              Windows Systems
            </p>
            <h1 class="mt-4 text-3xl font-bold tracking-tight text-navy sm:text-4xl md:text-5xl">
              Windows Systems
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-muted leading-relaxed">
              Deployment, management, and support for Windows desktops and servers. If it runs on
              Windows, I can set it up, fix it, and keep it running. Workstations, servers, Active
              Directory, Group Policy &mdash; the full stack.
            </p>
          </div>
        </div>
      </section>

      {/* Capabilities */}
      <section class="bg-surface py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {capabilities.map((cat) => (
              <div data-reveal>
                <div class="h-full rounded-xl border border-border bg-surface-light p-6">
                  <h2 class="text-lg font-semibold text-navy">{cat.title}</h2>
                  <ul class="mt-4 space-y-2.5">
                    {cat.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-sm text-muted">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                          aria-hidden="true"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Approach */}
      <section class="py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <div class="mx-auto max-w-3xl">
              <h2 class="text-2xl font-bold tracking-tight text-navy sm:text-4xl">
                How it works
              </h2>
              <div class="mt-6 space-y-4 text-muted leading-relaxed sm:text-lg">
                <p>
                  I don&apos;t do cookie-cutter deployments. Every setup starts with understanding
                  how your business actually uses its computers &mdash; what apps you rely on, how
                  your team works, and what&apos;s been causing problems.
                </p>
                <p>
                  From there I build a system that fits: properly configured, properly secured, and
                  documented so you&apos;re not dependent on anyone&apos;s memory of how things were
                  set up. Whether it&apos;s one workstation or a full server environment with Active
                  Directory, you get the same level of attention.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* CTA */}
      <section class="bg-surface py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <div class="mx-auto max-w-3xl text-center">
              <h2 class="text-2xl font-bold tracking-tight text-navy sm:text-4xl">
                Need Windows help?
              </h2>
              <p class="mt-4 text-lg text-muted">
                Whether it&apos;s a new deployment, an app that won&apos;t cooperate, or a server
                that needs attention &mdash; let&apos;s talk.
              </p>
              <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
                <a
                  href="/contact?service=Computers%2C%20Servers%20%26%20Cloud"
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-base font-semibold text-white transition-all hover:bg-accent-bright hover:shadow-lg hover:shadow-accent/15"
                >
                  Get a free quote
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="h-5 w-5"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </a>
                <a
                  href="tel:+15599001400"
                  class="inline-flex items-center justify-center gap-3 rounded-xl border border-border px-6 py-3.5 text-base font-medium text-foreground transition-colors hover:border-accent/30 hover:bg-surface-light"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5 text-accent"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  (559) 900-1400
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </>
  <Footer />
</Base>
