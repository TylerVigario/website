---
import ServicePage from "@/components/ServicePage.astro";

const capabilities = [
  {
    title: "Deployment & Setup",
    items: [
      "Clean OS installs and imaging",
      "Domain join and Active Directory setup",
      "Group Policy configuration",
      "User account provisioning",
      "Driver and peripheral setup",
      "Encryption and security hardening",
    ],
  },
  {
    title: "Ongoing Management",
    items: [
      "Windows Update and patch management",
      "Performance monitoring and tuning",
      "Backup configuration and verification",
      "Antivirus and endpoint security",
      "Remote management and access setup",
      "Hardware lifecycle planning",
    ],
  },
  {
    title: "Application Support",
    items: [
      "Line-of-business app installation and config",
      "Microsoft 365 and Office deployment",
      "Printer and scanner setup",
      "Application crashes and compatibility issues",
      "Database and POS system support",
      "Custom scripting and automation",
    ],
  },
];
---

<ServicePage
  path="/services/windows"
  title="Windows Systems"
  description="Windows deployment, management, and support for small businesses in the Central Valley. Workstations, servers, Active Directory, Group Policy, and patching."
  intro="Deployment, management, and support for Windows desktops and servers. If it runs on Windows, we can set it up, fix it, and keep it running. Workstations, servers, Active Directory, Group Policy — the full stack."
  capabilities={capabilities}
  serviceName="Windows Systems Management"
  serviceDescription="Windows deployment, management, and application support for desktops and servers."
  serviceTypes={["Windows Server Administration", "Windows Desktop Deployment", "Active Directory Management", "Windows Application Support"]}
  quoteService="Computers & Servers"
  approachTitle="How it works"
  ctaTitle="Need Windows help?"
  ctaText="Whether it's a new deployment, an app that won't cooperate, or a server that needs attention — let's talk."
>
  <p>
    We don&apos;t do cookie-cutter deployments. Every setup starts with understanding
    how your business actually uses its computers &mdash; what apps you rely on, how
    your team works, and what&apos;s been causing problems.
  </p>
  <p>
    From there we build a system that fits: properly configured, properly secured, and
    documented so you&apos;re not dependent on anyone&apos;s memory of how things were
    set up. Whether it&apos;s one workstation or a full server environment with Active
    Directory, you get the same level of attention.
  </p>
</ServicePage>
