---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

// Eager glob: previews become real imports, so they get a srcset and a
// missing file fails the build rather than 404ing.
const previews = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/work/**/*",
  { eager: true },
);
const preview = (rel: string) => {
  const hit = previews[`/src/assets/images/${rel}`];
  if (!hit) throw new Error(`No image at src/assets/images/${rel}`);
  return hit.default;
};
import Base from "@/layouts/Base.astro";
import { caseStudies, projects } from "@/lib/work";
import { WORK_CARD_SIZES } from "@/lib/image-sizes";
import OutcomePanel from "@/components/OutcomePanel.astro";
import PhotoCredit from "@/components/PhotoCredit.astro";

// The photos faded behind the cards, each once.
const backdrops = [...new Set(caseStudies.flatMap((cs) => cs.outcome?.backdrop ?? []))];

// Built from Astro.site so the canonical domain lives in one place.
const site = Astro.site!.href.replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${site}/work#collection`,
  name: "Work — Vigario Technology Solutions",
  url: `${site}/work`,
  about: {
    "@type": "ProfessionalService",
    "@id": `${site}/#business`,
    name: "Vigario Technology Solutions",
  },
  hasPart: caseStudies.map((cs) => ({
    "@type": "CreativeWork",
    name: cs.title,
    url: `${site}${cs.href}`,
    abstract: cs.summary,
  })),
};
---

<Base title="Work" description="Case studies: custom field-operations software, a home for an author's work, managed IT for a two-store family business, and telecom advocacy that saved it five figures." jsonLd={jsonLd}>

    <>
      {/* Hero */}
      <section class="pt-32 pb-12 lg:pb-16 lg:pt-36">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <p class="text-sm font-medium text-accent-ink">Case studies</p>
            <h1 class="mt-4 text-3xl font-bold tracking-tight text-navy sm:text-4xl md:text-5xl">
              Work
            </h1>
            <p class="mt-4 max-w-2xl text-lg text-muted leading-relaxed">
              Engagements where we built &mdash; or fought for &mdash; something real: custom
              field-operations software, a home for an author&apos;s work, and the IT that keeps a
              two-store family business running, including the telecom fight that saved it five
              figures.
            </p>
          </div>
        </div>
      </section>

      {/* Case-study cards */}
      <section class="pb-20 lg:pb-24">
        <div class="mx-auto max-w-6xl px-6">
          <div class="grid gap-6 lg:grid-cols-2">
            {caseStudies.map((cs) => (
              <div data-reveal>
                <a
                  href={cs.href}
                  class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-surface-light transition-all hover:-translate-y-1 hover:border-accent/30 hover:shadow-lg"
                >
                  {cs.preview ? (
                    <div class="relative aspect-video overflow-hidden border-b border-border bg-surface">
                      <Picture
                        src={preview(cs.preview)}
                        alt=""
                        formats={["avif"]}
                        fallbackFormat="webp"
                        pictureAttributes={{ class: "contents" }}
                        widths={[480, 768, 1024]}
                        sizes={WORK_CARD_SIZES}
                        class="absolute inset-0 h-full w-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-105"
                      />
                    </div>
                  ) : cs.outcome ? (
                    <OutcomePanel outcome={cs.outcome} />
                  ) : null}
                  <div class="flex flex-1 flex-col p-6 sm:p-8">
                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <span class="text-sm font-medium text-accent-ink">{cs.category}</span>
                      <span class="hidden text-border sm:inline" aria-hidden="true">
                        |
                      </span>
                      <span class="text-sm text-muted">
                        {cs.status} &middot; {cs.year}
                      </span>
                    </div>
                    <h2 class="mt-3 text-2xl font-bold tracking-tight text-navy">{cs.title}</h2>
                    <p class="mt-3 flex-1 text-muted leading-relaxed">{cs.summary}</p>
                    <div class="mt-6 flex flex-wrap gap-2">
                      {cs.tags.map((tag) => (
                        <span
                          class="rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted"
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                    <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-accent-ink transition-colors group-hover:text-navy">
                      Read the case study
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </span>
                  </div>
                </a>
              </div>
            ))}
          </div>
          {/* The cards are links, which cannot hold the credits' links, so
              the photos behind them are credited here. */}
          {backdrops.length > 0 && (
            <div class="mt-8 space-y-1 text-xs leading-relaxed text-muted">
              {backdrops.map((photo) => (
                <p><PhotoCredit photo={photo} /></p>
              ))}
            </div>
          )}
        </div>
      </section>

      {/* In development: real, unfinished, and labelled so */}
      <section class="bg-surface py-16 lg:py-20">
        <div class="mx-auto max-w-6xl px-6">
          <div data-reveal="up">
            <h2 class="text-2xl font-bold tracking-tight text-navy sm:text-4xl">In development</h2>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">
              Software we&apos;re building now. Both will change a lot before they&apos;re done.
            </p>
          </div>
          <div class="mt-10 grid gap-6 lg:grid-cols-2">
            {projects.map((p) => (
              <div data-reveal>
                <div class="flex h-full flex-col rounded-2xl border border-border bg-surface-light p-6 sm:p-8">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="text-sm font-medium text-accent-ink">{p.category}</span>
                    <span class="hidden text-border sm:inline" aria-hidden="true">
                      |
                    </span>
                    <span class="text-sm text-muted">{p.status}</span>
                  </div>
                  <h3 class="mt-3 text-2xl font-bold tracking-tight text-navy">{p.title}</h3>
                  <p class="mt-3 flex-1 leading-relaxed text-muted">{p.summary}</p>
                  <div class="mt-6 flex flex-wrap gap-2">
                    {p.tags.map((tag) => (
                      <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs text-muted">
                        {tag}
                      </span>
                    ))}
                  </div>
                  {p.href && (
                    <a
                      href={p.href}
                      class="mt-6 inline-flex items-center gap-1.5 self-start text-sm font-semibold text-accent-ink transition-colors hover:text-navy"
                    >
                      Read the source
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                        class="h-4 w-4"
                        aria-hidden="true"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                          clip-rule="evenodd"
                        />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </>
</Base>
