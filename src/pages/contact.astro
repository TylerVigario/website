---
import Base from "@/layouts/Base.astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import QuoteForm from "@/components/QuoteForm.astro";

// Rendered per request, not prerendered. The no-JS path redirects back
// here carrying the submitted values and errors, and a prerendered page
// reads Astro.url.searchParams at BUILD time — it would be empty and
// the repopulation would silently do nothing. Pages that accept input
// are dynamic; the rest of the site stays files on disk.
export const prerender = false;
const params = Astro.url.searchParams;
const parseParam = (key: string) => {
  const raw = params.get(key);
  if (!raw) return {};
  try {
    return JSON.parse(raw) as Record<string, never>;
  } catch {
    return {};
  }
};
const values = parseParam("v");
const errors = parseParam("e");
const submitted = params.get("sent") === "1";
---

<Base title="Contact" description="Get in touch with Vigario Technology Solutions.">
  <Nav />
  <main id="main" class="mx-auto max-w-2xl px-6 pt-32 pb-16">
    <h1 class="text-3xl font-bold text-navy">Get in touch</h1>
    <div class="mt-8"><QuoteForm values={values} errors={errors} submitted={submitted} /></div>
  </main>
  <Footer />
</Base>
