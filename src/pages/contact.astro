---
import Base from "@/layouts/Base.astro";
import QuoteForm from "@/components/QuoteForm.astro";
import { readSubmission, submitQuote, unreadableMessage, type Values } from "@/lib/api/submit";
import { services as catalog } from "@/lib/services";

// Rendered per request, not prerendered: this page takes the form's
// no-JS submit, below. Pages that accept input are dynamic; the rest of
// the site stays files on disk.
export const prerender = false;
// These responses can carry what someone typed: a submit that fails
// validation is re-rendered with the values echoed back into the form,
// so the HTML contains a real person's name, contact details and
// message. Nothing may store that: not a browser cache a shared machine
// can be walked up to, not an intermediary, not the back button
// restoring it for whoever is next.
//
// no-store rather than no-cache — no-cache permits storage as long as
// the cache revalidates, which is the wrong answer when the objection
// is the storing itself.
Astro.response.headers.set("Cache-Control", "no-store");

// The no-JS submit lands here, posted by the form to its own page. It
// used to go to the API, which redirected back with everything typed in
// the query string: that put names and messages into browser history and
// access logs, failed outright once the text outgrew a request line, and
// let anyone put words in the form's alert box through a crafted link.
// Now a failure re-renders this page, 422, with every value still in the
// form, and nothing typed is ever in a URL. Success redirects, so a
// reload cannot submit twice. The work is submitQuote(), the same function
// the JSON API calls.
let values: Values = {};
let errors: Record<string, string> = {};
if (Astro.request.method === "POST") {
  const outcome = await submitQuote(await readSubmission(Astro.request, ["services"]));
  if (outcome.kind === "unreadable") {
    // Nothing was read, so nothing can be echoed back: the form comes
    // back empty, with a message that says so rather than one that
    // blames a field.
    errors = { "(root)": unreadableMessage(outcome.status) };
    Astro.response.status = outcome.status;
  } else if (outcome.kind === "invalid") {
    ({ values, errors } = outcome);
    Astro.response.status = 422;
  } else {
    return Astro.redirect("/contact?sent=1", 303);
  }
}
const submitted = Astro.url.searchParams.get("sent") === "1";

// The service pages link here as /contact?service=<title>, promising the
// form arrives with that service ticked. Only a title the catalog has is
// honoured, and it only ever ticks a box that already exists, so nothing
// from the link is echoed into the page.
const preselect = Astro.url.searchParams.get("service");
if (Astro.request.method !== "POST" && preselect && catalog.some((s) => s.title === preselect)) {
  values = { services: [preselect] };
}
---

<Base title="Contact" description="Request a quote for IT work in Fresno and the Central Valley: networking, security cameras, cabling, servers or custom software. Call or text (559) 900-1400." mainClass="mx-auto max-w-2xl px-6 pt-32 pb-16">
  <h1 class="text-3xl font-bold text-navy">Get in touch</h1>
  <div class="mt-8"><QuoteForm values={values} errors={errors} submitted={submitted} /></div>
</Base>
