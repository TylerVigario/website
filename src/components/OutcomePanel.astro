---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CaseStudy } from "@/lib/work";
import { CASE_STUDY_LEAD_SIZES, WORK_CARD_SIZES } from "@/lib/image-sizes";
import PhotoCredit from "@/components/PhotoCredit.astro";

/**
 * A client's logo over the engagement's outcome, for a case study with no
 * screenshot to lead with. One panel in two places: the /work card, and
 * the hero of the case study itself, so the two cannot show different
 * numbers.
 *
 * The logo is drawn at a fixed height, so it is served at that height and
 * twice it, and Astro works out the width.
 *
 * A backdrop, when the outcome has one, is the client's own place, faded
 * behind the logo. The wash is white at 90% in the middle, where the text
 * is, thinning to 65% at the corners; on a phone the text reaches nearly
 * to the corners, so there it thins only to 80%. The muted caption keeps
 * at least 4.5:1 over the darkest pixel behind it, measured with the text
 * hidden at 360 to 1440px. The photo is decorative here, so its alt is
 * empty. In a hero the credit goes right under the panel; a card is a
 * link, which cannot hold the credit's links, so /work credits those.
 */
interface Props {
  outcome: NonNullable<CaseStudy["outcome"]>;
  /** The case study's own hero: larger, bordered, and loaded first. */
  lead?: boolean;
}
const { outcome, lead = false } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>("/src/assets/images/work/**/*", {
  eager: true,
});
const logo = images[`/src/assets/images/${outcome.logo}`]?.default;
if (!logo) throw new Error(`No image at src/assets/images/${outcome.logo}`);
// The logo's height in px at its largest, from the classes below (sm:h-11
// on a card, sm:h-16 in a hero). Astro sizes it from that and serves a
// 2x copy for dense screens. Reading the logo's own width or height here
// would make the build ship the original file as well, so nothing does.
const height = lead ? 64 : 44;

// A hero with a backdrop is a figure, so its credit can be its caption.
const Frame = lead && outcome.backdrop ? "figure" : Fragment;
---

<Frame>
<div
  class:list={[
    "relative flex aspect-video flex-col items-center justify-center overflow-hidden px-6 text-center",
    outcome.backdrop ? "bg-surface-light" : "bg-linear-to-br from-accent/5 via-surface to-surface",
    lead ? "rounded-xl border border-border shadow-2xl" : "border-b border-border",
  ]}
>
  {
    outcome.backdrop && (
      <>
        <Picture
          src={outcome.backdrop.src}
          alt=""
          formats={["avif"]}
          fallbackFormat="webp"
          pictureAttributes={{ class: "contents" }}
          priority={lead}
          widths={[480, 768, 1024]}
          sizes={lead ? CASE_STUDY_LEAD_SIZES : WORK_CARD_SIZES}
          class:list={[
            "absolute inset-0 h-full w-full object-cover",
            !lead && "transition-transform duration-500 ease-out group-hover:scale-105",
          ]}
        />
        <div class="absolute inset-0 bg-radial from-surface-light/90 from-60% to-surface-light/80 sm:from-30% sm:to-surface-light/65" />
      </>
    )
  }
  <div class:list={["relative flex flex-col items-center", lead ? "gap-4" : "gap-3"]}>
    <Picture
      src={logo}
      alt={outcome.logoAlt}
      formats={["avif"]}
      fallbackFormat="webp"
      pictureAttributes={{ class: "contents" }}
      priority={lead}
      height={height}
      densities={[1, 2]}
      class:list={[
        "w-auto",
        lead
          ? "h-12 sm:h-16"
          : "h-9 transition-transform duration-500 ease-out group-hover:scale-105 sm:h-11",
      ]}
    />
    <div class="flex items-baseline justify-center gap-2.5">
      {
        outcome.before && (
          <>
            <span
              class:list={[
                "font-semibold text-muted line-through decoration-muted/40",
                lead ? "text-lg sm:text-xl" : "text-base",
              ]}
            >
              {outcome.before}
            </span>
            <span class="text-muted" aria-hidden="true">
              &rarr;
            </span>
          </>
        )
      }
      <span class:list={["font-bold text-accent-ink", lead ? "text-3xl sm:text-4xl" : "text-2xl"]}>
        {outcome.after}
      </span>
    </div>
    <p
      class:list={[
        "font-medium uppercase tracking-wider text-muted",
        lead ? "text-xs" : "text-[0.7rem]",
      ]}
    >
      {outcome.caption}
    </p>
  </div>
</div>
{
  lead && outcome.backdrop && (
    <figcaption class="mt-3 text-xs leading-relaxed text-muted">
      <PhotoCredit photo={outcome.backdrop} />
    </figcaption>
  )
}
</Frame>
