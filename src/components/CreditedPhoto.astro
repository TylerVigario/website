---
import { Picture } from "astro:assets";
import type { CreditedPhoto } from "@/lib/photos";
import PhotoCredit from "@/components/PhotoCredit.astro";

/**
 * A photograph someone else took, with the credit its licence asks for
 * right under it. Drawn 4:3 and cropped to `position`.
 */
interface Props {
  photo: CreditedPhoto;
  sizes: string;
  /** object-position, as a Tailwind class: which part survives the crop. */
  position?: string;
}
const { photo, sizes, position = "object-center" } = Astro.props;
---

<figure>
  <div class="overflow-hidden rounded-xl border border-border bg-surface">
    <Picture
      src={photo.src}
      alt={photo.alt}
      formats={["avif"]}
      fallbackFormat="webp"
      pictureAttributes={{ class: "contents" }}
      widths={[480, 768, 1024, 1536]}
      sizes={sizes}
      class:list={["aspect-4/3 w-full object-cover", position]}
    />
  </div>
  <figcaption class="mt-3 text-xs leading-relaxed text-muted">
    <PhotoCredit photo={photo} />
  </figcaption>
</figure>
