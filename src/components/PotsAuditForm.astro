---
import { BILL_RANGES } from "@/lib/api/pots-audit";
import { servedStamp } from "@/lib/api/form-stamp";
import Honeypot from "@/components/form/Honeypot.astro";
import RootError from "@/components/form/RootError.astro";
import DetailsField from "@/components/form/DetailsField.astro";
import SubmitRow from "@/components/form/SubmitRow.astro";
import FormConfirmation from "@/components/form/FormConfirmation.astro";
import { INPUT_CLASS } from "@/components/form/input-class";
// The audit form from the POTS landing page. Same machinery as
// QuoteForm — one enhancement module, one never-erase guarantee, one
// no-JS path — differing only in fields.
interface Props {
  values?: Record<string, string | string[]>;
  errors?: Record<string, string>;
  submitted?: boolean;
}
const { values = {}, errors = {}, submitted = false } = Astro.props;

const str = (k: string) => {
  const v = values[k];
  return typeof v === "string" ? v : "";
};


const fields = [
  { id: "business", label: "Business name", hint: null, autocomplete: "organization" },
  { id: "name", label: "Your name", hint: null, autocomplete: "name" },
  {
    id: "contact",
    label: "Phone or email",
    hint: "Either is fine — whichever you'd rather we use.",
    // No single token means "phone or email", so none is claimed.
    autocomplete: undefined,
  },
] as const;
---

{
  submitted ? (
    <FormConfirmation form="pots-audit" />
  ) : (
    <>
    <form method="post" action="/pots-migration#audit" novalidate data-pots-form class="group">
      <Honeypot id="pots-website" />
      {/* When the server rendered this form, so a submission can be told
          from one posted straight back by a script. A re-render after a
          failed send keeps the stamp it was sent with. See fill-time.ts. */}
      <input type="hidden" name="served" value={servedStamp(values)} />
      <RootError message={errors["(root)"]} />

      {fields.map((f) => (
        <div class="mb-4">
          <label for={f.id} class="mb-1.5 block text-sm font-medium text-foreground">
            {f.label}
          </label>
          {f.hint && (
            <p id={`${f.id}-hint`} class="mb-1.5 text-sm text-muted">
              {f.hint}
            </p>
          )}
          <input
            id={f.id}
            name={f.id}
            type="text"
            autocomplete={f.autocomplete}
            value={str(f.id)}
            aria-required="true"
            aria-invalid={errors[f.id] ? "true" : undefined}
            aria-describedby={[errors[f.id] && `${f.id}-error`, f.hint && `${f.id}-hint`].filter(Boolean).join(" ") || undefined}
            class={INPUT_CLASS}
          />
          {errors[f.id] && (
            <p id={`${f.id}-error`} role="alert" class="mt-1.5 text-sm text-red-600">
              {errors[f.id]}
            </p>
          )}
        </div>
      ))}

      <div class="mb-4">
        <label for="bill" class="mb-1.5 block text-sm font-medium text-foreground">
          Roughly what do the lines cost you monthly?
        </label>
        <p id="bill-hint" class="mb-1.5 text-sm text-muted">
          A range is fine — we only need it to know where to start looking.
        </p>
        <select
          id="bill"
          name="bill"
          aria-required="true"
          aria-invalid={errors.bill ? "true" : undefined}
          aria-describedby={errors.bill ? "bill-error bill-hint" : "bill-hint"}
          class={INPUT_CLASS}
        >
          <option value="">Pick a range…</option>
          {BILL_RANGES.map((r) => (
            <option value={r} selected={str("bill") === r}>
              {r}
            </option>
          ))}
        </select>
        {errors.bill && (
          <p id="bill-error" role="alert" class="mt-1.5 text-sm text-red-600">
            {errors.bill}
          </p>
        )}
      </div>

      <DetailsField value={str("details")} rows={3} />

      <SubmitRow label="Get my free audit" />
    </form>
    <template data-confirmation="pots-audit">
      <FormConfirmation form="pots-audit" />
    </template>
    </>
  )
}

<script>
  import "@/scripts/pots-audit-form";
</script>
