---
import { Picture } from "astro:assets";
import cables from "@/assets/images/stock/blue-cables-switch.jpg";

const stats = [
  { value: "20+", label: "Years in Tech" },
  { value: "Full Stack", label: "Cable to Code" },
  { value: "Local", label: "Central Valley" },
];
---


    {/* The first screen, on every device: at least the visible viewport
        (svh, which leaves out a phone's address bar and does not change
        as it slides away), taller only when the content needs it. The
        fixed header covers the top 5rem, so the top padding is that much
        more than the bottom and the content centres in what shows. */}
    <section class="relative flex min-h-svh items-center overflow-hidden">
      {/* Background: the photo, then navy over it. Text over a photo has to
          clear WCAG AA where the photo is brightest, a white cable label
          behind it: 80% navy keeps the paragraph at 5.5:1 and the stat
          labels at 4.6:1 even there. Phones get 80% throughout. Desktop
          is solid to 40% of the width and at least 85% to 60%, which is
          past the paragraph's right edge at 1024px (59%), then thins so
          the cables show on the right. */}
      <div class="absolute inset-0 -z-10 bg-navy">
        <Picture
          src={cables}
          alt=""
          width={2400}
          height={1600}
          priority
          formats={["avif"]}
          fallbackFormat="webp"
          pictureAttributes={{ class: "contents" }}
          widths={[640, 960, 1280, 1600, 2400]}
          sizes="100vw"
          class="h-full w-full object-cover object-[70%_center]"
        />
        <div class="absolute inset-0 bg-navy/80 lg:bg-transparent lg:bg-linear-to-r lg:from-navy lg:from-40% lg:via-navy/85 lg:via-60% lg:to-navy/10" />
      </div>

      <div class="relative mx-auto w-full max-w-6xl px-6 pt-26 pb-8 sm:pt-32 sm:pb-12 lg:pb-10">
        <div data-reveal="up">
          <div class="mx-auto max-w-3xl text-center lg:mx-0 lg:max-w-2xl lg:text-left">
            <h1 class="text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl md:text-6xl">
              Your IT shop that <span class="text-accent-bright">actually picks up</span>
            </h1>

            <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-white/80 sm:text-lg lg:mx-0 lg:max-w-xl">
              From pulling cable to writing custom software, we handle the full stack for small
              businesses in the Central Valley. No ticket queues, no runaround &mdash; just 20+
              years of hands-on experience and a direct line.
            </p>

            <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center sm:gap-4 lg:justify-start">
              <a
                href="/contact"
                class="flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 text-base font-semibold text-white transition-all sm:w-auto sm:px-8 sm:py-4 sm:text-lg hover:bg-accent-ink hover:shadow-lg hover:shadow-accent/25 focus-visible:outline-white"
              >
                Get a free quote
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
              <a
                href="tel:+15599001400"
                class="flex w-full items-center justify-center gap-3 rounded-xl border border-white/20 px-6 py-3.5 text-base font-medium text-white transition-colors sm:w-auto sm:px-8 sm:py-4 sm:text-lg hover:border-white/40 hover:bg-white/5 focus-visible:outline-white"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="h-5 w-5 text-accent-bright"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
                    clip-rule="evenodd"
                  />
                </svg>
                (559) 900-1400
              </a>
            </div>
          </div>
        </div>

        {/* Stats bar */}
        <div data-reveal>
          <div class="mx-auto mt-10 flex max-w-2xl flex-wrap items-center justify-center gap-x-12 gap-y-6 sm:mt-14 lg:mx-0 lg:mt-10 lg:justify-start">
            {stats.map((s, i) => (
              <div class="flex items-center gap-x-12">
                {i > 0 && <div class="hidden h-8 w-px bg-white/15 sm:block" />}
                <div class="text-center lg:text-left">
                  <div class="text-xl font-bold text-accent-bright sm:text-2xl">{s.value}</div>
                  <div class="mt-1 text-xs text-white/70 sm:text-sm">{s.label}</div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
