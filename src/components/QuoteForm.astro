---
import { services as serviceCatalog } from "@/lib/services";
import { servedStamp } from "@/lib/api/form-stamp";
import Honeypot from "@/components/form/Honeypot.astro";
import RootError from "@/components/form/RootError.astro";
import DetailsField from "@/components/form/DetailsField.astro";
import SubmitRow from "@/components/form/SubmitRow.astro";
import FormConfirmation from "@/components/form/FormConfirmation.astro";
import { INPUT_CLASS } from "@/components/form/input-class";

// Without JavaScript the form posts to its own page (/contact), which
// re-renders this component with `values` and `errors` populated when
// the submit fails validation, so nothing typed is lost on that path
// either. With JavaScript, enhance() posts JSON to /api/quote instead.
interface Props {
  values?: Record<string, string | string[]>;
  errors?: Record<string, string>;
  submitted?: boolean;
}
const { values = {}, errors = {}, submitted = false } = Astro.props;

const serviceOptions = serviceCatalog.map((s) => s.title);
const str = (k: string) => (typeof values[k] === "string" ? values[k] : "");
const picked = Array.isArray(values.services) ? values.services : [];

---

{
  submitted ? (
    <FormConfirmation form="quote" />
  ) : (
    <>
    <form method="post" action="/contact" novalidate data-quote-form class="group">
      <Honeypot id="quote-website" />
      {/* When the server rendered this form, so a submission can be told
          from one posted straight back by a script. A re-render after a
          failed send keeps the stamp it was sent with. See fill-time.ts. */}
      <input type="hidden" name="served" value={servedStamp(values)} />
      <RootError message={errors["(root)"]} />

      <div class="mb-4">
        <label for="name" class="mb-1.5 block text-sm font-medium text-foreground">Name</label>
        <input
          id="name"
          name="name"
          autocomplete="name"
          type="text"
          value={str("name")}
          aria-required="true"
          aria-invalid={errors.name ? "true" : undefined}
          aria-describedby={errors.name ? "name-error" : undefined}
          class={INPUT_CLASS}
        />
        {errors.name && (
          <p id="name-error" role="alert" class="mt-1.5 text-sm text-red-600">
            {errors.name}
          </p>
        )}
      </div>

      <div class="mb-4">
        <label for="contact" class="mb-1.5 block text-sm font-medium text-foreground">
          Phone or email
        </label>
        {/* The constraint is stated here, before it can be failed. */}
        <p id="contact-hint" class="mb-1.5 text-sm text-muted">
          Either is fine — whichever you'd rather we use.
        </p>
        <input
          id="contact"
          name="contact"
          type="text"
          value={str("contact")}
          aria-required="true"
          aria-describedby={errors.contact ? "contact-error contact-hint" : "contact-hint"}
          aria-invalid={errors.contact ? "true" : undefined}
          class={INPUT_CLASS}
        />
        {errors.contact && (
          <p id="contact-error" role="alert" class="mt-1.5 text-sm text-red-600">
            {errors.contact}
          </p>
        )}
      </div>

      <fieldset class="mb-4">
        <legend class="mb-1.5 block text-sm font-medium text-foreground">
          What do you need help with?
        </legend>
        <p id="services-hint" class="mb-2 text-sm text-muted">
          Pick at least one. More than one is fine.
        </p>
        <div class="flex flex-wrap gap-2">
          {serviceOptions.map((service) => (
            <label class="cursor-pointer">
              <input
                type="checkbox"
                name="services"
                value={service}
                checked={picked.includes(service)}
                aria-invalid={errors.services ? "true" : undefined}
                aria-describedby={errors.services ? "services-error services-hint" : "services-hint"}
                class="peer sr-only"
              />
              <span class="inline-block rounded-full border border-border px-4 py-2 text-sm transition-colors peer-checked:border-accent peer-checked:bg-accent-soft peer-checked:text-accent-ink peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent">
                {service}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      {errors.services && (
        <p id="services-error" role="alert" class="mt-1.5 text-sm text-red-600">
          {errors.services}
        </p>
      )}

      <DetailsField value={str("details")} rows={4} />

      <SubmitRow label="Send it over" />
    </form>
    <template data-confirmation="quote">
      <FormConfirmation form="quote" />
    </template>
    </>
  )
}

<script>
  import "@/scripts/quote-form";
</script>
