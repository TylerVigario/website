---
import QuoteForm from "@/components/QuoteForm.astro";
---


    <section class="relative pb-8 pt-16 lg:py-20">
      <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-border to-transparent" />

      <div class="mx-auto max-w-6xl px-6">
        <div class="fade-in">
          <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
            {/* Left — copy */}
            <div class="lg:py-4">
              <h2 class="text-2xl font-bold tracking-tight text-navy sm:text-4xl lg:text-5xl">
                Get a free quote
              </h2>
              <p class="mt-4 text-lg text-muted">
                Tell us a bit about what you need and we&apos;ll get back to you with a clear scope
                and honest estimate &mdash; free, before you commit to anything.
              </p>

              <div class="mt-8 space-y-4">
                <div class="flex items-center gap-3 text-muted">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0 text-accent"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>
                    Rather talk? 
                    <a
                      href="tel:+15599001400"
                      class="inline-block py-2.5 -my-2.5 font-medium text-foreground hover:text-accent"
                    >
                      (559) 900-1400
                    </a>
                  </span>
                </div>
                <div class="flex items-center gap-3 text-muted">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-5 w-5 shrink-0 text-accent"
                    aria-hidden="true"
                  >
                    <path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z" />
                    <path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z" />
                  </svg>
                  <span>
                    Email: 
                    <a
                      href="mailto:contact@vigario.tech"
                      class="inline-block py-2.5 -my-2.5 font-medium text-foreground hover:text-accent"
                    >
                      contact@vigario.tech
                    </a>
                  </span>
                </div>
              </div>

              <div class="mt-10 space-y-3 text-sm text-muted">
                <div class="flex items-start gap-2.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>Transparent hourly rate &mdash; no retainers, no hidden fees</span>
                </div>
                <div class="flex items-start gap-2.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>Scope and estimate before any work starts</span>
                </div>
                <div class="flex items-start gap-2.5">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 20 20"
                    fill="currentColor"
                    class="mt-0.5 h-4 w-4 shrink-0 text-accent"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                      clip-rule="evenodd"
                    />
                  </svg>
                  <span>Fresno area on-site &mdash; remote available anywhere</span>
                </div>
              </div>
            </div>

            {/* Right — form */}
            <div class="rounded-2xl border border-border bg-surface-light p-6 sm:p-8">
              <QuoteForm />
            </div>
          </div>
        </div>
      </div>
    </section>
