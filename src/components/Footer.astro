---
import { Image } from "astro:assets";
import imgVtsLogo0 from "@/assets/images/vts-logo.png";
import GitHub from "@/components/icons/GitHub.astro";
import MapPin from "@/components/icons/MapPin.astro";

const nav = [
  { label: "Services", href: "/services" },
  { label: "Work", href: "/work" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const external = [
  { label: "GitHub", href: "https://github.com/tylervigario", icon: "gh" },
  { label: "Google Business", href: "https://g.co/kgs/wyVQ2pD", icon: "pin" },
] as const;

// Baked at build time, not evaluated in the browser. A prerendered page
// would otherwise freeze whatever year the build ran in either way —
// this just makes that explicit rather than looking like it updates.
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-8 sm:py-12">
  <div class="mx-auto max-w-6xl px-6">
    <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
      <div class="text-center md:text-left">
        <address class="not-italic">
          <a href="/" class="inline-block py-2">
            <Image
              src={imgVtsLogo0}
              alt="Vigario Technology Solutions"
              width="330"
              height="124"
              class="h-7 w-auto"
              loading="lazy" />
          </a>
          <p class="mt-2 text-sm text-muted">Fresno, CA &middot; Available remotely nationwide</p>
        </address>

        {/* Outside the <address>, deliberately. That element is for contact
            details — a machine reading it should not be told this is one.
            It sits in the same column so it reads as part of the identity
            block rather than as fine print.

            <blockquote> + <cite> because that is what this is: the phrase
            is quoted from Romans 10:9, and the reference is its source. A
            bare <span> would render the same and say nothing about how the
            two relate. `not-italic` because <cite> italicises by default
            and nothing else in this footer is italic — the <address> above
            carries the same override.

            The middot separator and the underlined link match what the
            rest of the footer already does, so the citation reads as one
            more link rather than a differently-styled exception. */}
        <blockquote class="mt-3 text-sm text-muted">
          <p>
            <span class="font-medium text-foreground">Jesus is Lord</span> &middot;{" "}
            <cite class="not-italic">
              <a
                href="https://openbible.com/par/romans/10-9.htm"
                target="_blank"
                rel="noopener noreferrer"
                class="underline transition-colors hover:text-foreground">Romans 10:9</a
              >
            </cite>
          </p>
        </blockquote>
      </div>

      <nav
        class="flex flex-wrap items-center justify-center gap-4 text-sm text-muted md:gap-6"
        aria-label="Footer navigation"
      >
        {
          nav.map((l, i) => (
            <>
              {i > 0 && <span class="hidden text-border md:inline">|</span>}
              <a href={l.href} class="py-3 transition-colors hover:text-foreground">
                {l.label}
              </a>
            </>
          ))
        }
      </nav>
    </div>

    <div
      class="mt-6 flex flex-col items-center gap-3 text-sm text-muted md:flex-row md:justify-center md:gap-6"
    >
      <a href="tel:+15599001400" class="py-3 transition-colors hover:text-foreground">
        (559) 900-1400
      </a>
      <span class="hidden text-border md:inline">|</span>
      <a
        href="mailto:tyler@tylervigario.com"
        class="py-3 transition-colors hover:text-foreground"
      >
        tyler@tylervigario.com
      </a>
      {
        external.map((l) => (
          <>
            <span class="hidden text-border md:inline">|</span>
            <a
              href={l.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 py-3 transition-colors hover:text-foreground"
            >
              {l.icon === "gh" ? <GitHub /> : <MapPin />}
              {l.label}
            </a>
          </>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col items-center gap-1 text-center text-xs text-muted">
      <p>&copy; {year} Vigario Technology Solutions</p>
      <p>
        Code licensed under{" "}
        <a
          href="https://www.gnu.org/licenses/agpl-3.0.html"
          target="_blank"
          rel="noopener noreferrer"
          class="underline transition-colors hover:text-foreground">AGPL-3.0-or-later</a
        >
        {" \u00b7 "}
        {/* Offering the source is what makes the AGPL notice above mean
            something: the network-use clause binds whoever modifies this
            and serves it, and can only bind them if they can get it. If
            the repository is renamed or moved, this link moves with it —
            a dead link here is worse than none, because it claims an
            offer that is not being kept. */}
        <a
          href="https://github.com/TylerVigario/website"
          target="_blank"
          rel="noopener noreferrer"
          class="underline transition-colors hover:text-foreground">Source</a
        >
      </p>
    </div>
  </div>
</footer>
