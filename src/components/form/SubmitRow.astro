---
/** The send button, which says it is sending while a JSON send is in
 *  flight (data-submitting, set by enhance.ts), and the line on how what
 *  is sent is handled. */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="submit"
  class="w-full rounded-lg bg-accent px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-ink disabled:opacity-70 group-data-submitting:cursor-progress"
>
  <span class="group-data-submitting:hidden">{label}</span>
  <span class="hidden group-data-submitting:inline">Sending…</span>
</button>
<p class="mt-3 text-center text-xs text-muted">
  Used only to reply to you, and checked for spam.{" "}
  <a href="/privacy" class="underline hover:text-foreground">How it's handled</a>
</p>
