---
// The single layout every page wraps in — the Astro equivalent of the
// old src/app/layout.tsx. Anything that used to live in Next's exported
// `metadata` object is a prop here, because Astro has no metadata API:
// the page passes what it wants and this file writes the tags.
import "@fontsource-variable/geist";
import "@/styles/global.css";
// The `?url` suffix asks Vite for the emitted, content-hashed path
// rather than the file's bytes — so the preload below points at the
// same asset the stylesheet resolves to and cannot drift from it.
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
// The social card. Imported rather than written as a path so the URL is
// whatever Astro emits — the same reason the JSON-LD logo is imported.
import ogCard from "@/assets/images/og-card.png";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  /** Page title. Rendered as "<title> | Vigario Technology Solutions"
   * when that fits the ~60 characters a search result shows, and bare
   * when it does not: a result already names the site above its title,
   * so cutting the title to fit the suffix would trade the page's own
   * words for a second copy of the name. */
  title: string;
  description: string;
  /** Drops the " | Vigario Technology Solutions" suffix. The home page
   * carried the untemplated default title; the POTS page's own title
   * already fills the ~60 characters a search result shows, and with
   * the suffix it ran to 92 and was cut off mid-phrase. */
  bareTitle?: boolean;
  /** Canonical override. Defaults to the current URL, which is what
   * every page wants; only set it where two routes serve one page. */
  canonical?: string;
  /** schema.org structured data. Built in the page so it can reference
   * page data, but serialised here so every page emits it the same way
   * and nothing hardcodes the domain. */
  jsonLd?: unknown;
  /** Classes for the page's <main>, for pages whose content is laid
   * out on the landmark itself rather than on sections inside it. */
  mainClass?: string;
  /** Open Graph type. "article" for the case studies, which are written
   * pieces with a date; everything else is the site. */
  ogType?: "website" | "article";
  /** For pages that must never appear in search: the error pages, which
   * are also reachable as /404.html and /500.html with a 200. Drops the
   * canonical too, since there is no indexable URL to point at. */
  noindex?: boolean;
  /** The picture a shared link shows, for a page with one of its own (a
   * case study's lead screenshot). Cropped to the 1.91:1 card the
   * platforms draw, from the top unless `position` says otherwise, since
   * a screenshot's header is at the top. Without it, the site's card. */
  ogImage?: { src: ImageMetadata; alt: string; position?: "top" | "center" };
}

const {
  title,
  description,
  bareTitle = false,
  canonical,
  jsonLd,
  mainClass,
  ogType = "website",
  noindex = false,
  ogImage,
} = Astro.props;

const SUFFIX = " | Vigario Technology Solutions";
const TITLE_MAX = 60;
const fullTitle =
  bareTitle || title.length + SUFFIX.length > TITLE_MAX ? title : `${title}${SUFFIX}`;

// Astro.site comes from `site` in astro.config.ts. Building the URL
// from it rather than hardcoding means the domain move to vigario.tech
// is a one-line config change, not a grep.
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;

// JPEG, because not every scraper reads AVIF or WebP.
const card = ogImage
  ? await getImage({
      src: ogImage.src,
      width: 1200,
      height: 630,
      fit: "cover",
      position: ogImage.position ?? "top",
      format: "jpg",
    })
  : undefined;
const share = card
  ? {
      url: new URL(card.src, Astro.site).href,
      width: String(card.attributes.width),
      height: String(card.attributes.height),
      alt: ogImage?.alt ?? "",
    }
  : {
      url: new URL(ogCard.src, Astro.site).href,
      width: String(ogCard.width),
      height: String(ogCard.height),
      alt: "Vigario Technology Solutions — IT services in the Central Valley",
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fafaf9" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {/* Without this the font is a third-level discovery: the browser
        must fetch the HTML, parse it, fetch the CSS, parse THAT, and
        only then learn the font exists. Preloading collapses that to
        two levels — the fetch starts alongside the CSS instead of
        after it. Same bytes, one less round trip in series, which is
        the difference that shows on a slow link.

        Only the latin subset is preloaded. The others (cyrillic,
        greek, vietnamese) are declared in the stylesheet with their
        own unicode-range and are never fetched for English text —
        preloading them would be pure waste. */}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {/* apple-touch-icon must be a PNG. iOS does not render SVG here, so
        the SVG this used to point at produced a blank home-screen icon.
        It also composites onto black if transparent, hence the opaque
        background baked into the file. */}
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Vigario Technology Solutions" />
    <meta property="og:locale" content="en_US" />
    {/* og:image is what makes summary_large_image mean anything. Without
        it every share on LinkedIn, X, Slack or iMessage rendered as a
        bare link — the card was promised and never supplied. Absolute
        URL because scrapers do not resolve relative ones. */}
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={share.width} />
    <meta property="og:image:height" content={share.height} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={share.url} />
    {
      jsonLd && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body class="font-sans antialiased overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-100 focus-visible:rounded-lg focus-visible:bg-accent focus-visible:px-4 focus-visible:py-3 focus-visible:text-white focus-visible:outline-none"
    >
      Skip to content
    </a>
    {/* The frame lives here, once, rather than in every page. When each
        page repeated it by hand, eleven of fifteen left out <main> — so
        the skip link above pointed at nothing and there was no main
        landmark — and the POTS page ended up with two headers and two
        footers. A page now supplies its content; the frame is not
        something it can forget or double.

        The header and footer are slots with the site's own as the
        fallback, so a page that needs a different one says so
        explicitly (slot="header") instead of rebuilding the frame. */}
    <slot name="header"><Nav /></slot>
    <main id="main" class={mainClass}>
      <slot />
    </main>
    <slot name="footer"><Footer /></slot>
    <script>
      import "@/scripts/reveal";
    </script>
  </body>
</html>
