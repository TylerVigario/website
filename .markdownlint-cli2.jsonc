{
  // Markdown lint config.
  "config": {
    "MD013": false, // line-length: disabled (prose doesn't hard-wrap)
    "MD033": false, // no-inline-html: allowed for occasional <kbd>, <details>, etc.
    "MD041": false, // first-line-h1: not every fragment needs to start with h1
    "MD060": false // table-column-style: short-form tables preferred; not auto-fixable so the rule just nags
  },
  "globs": ["**/*.md"],
  // Whatever git ignores, as Prettier does: dependencies, build output and
  // the release staging tree, whose packages ship Markdown of their own.
  // A list kept here instead missed dist-release/.
  "gitignore": true,
  // CHANGELOG.md is generated by git-cliff — lint it and you are
  // linting the generator's output, which you cannot fix by hand.
  "ignores": ["CHANGELOG.md"]
}
