# vigario-website canonical default environment.
#
# Installed read-only at /usr/lib/vigario-website/default.env
# (RPM-owned; do NOT edit). Operator overrides live at
# /etc/sysconfig/vigario-website (not shipped by the RPM); the
# systemd unit loads BOTH files and the operator's values win.
#
# This file documents every env var the runtime understands. Anything
# not listed here is ignored.

# Bind address. server.ts default is 127.0.0.1; Apache reverse-proxies.
HOSTNAME=127.0.0.1
PORT=3000

# SQLite database path. Must be absolute (runtime-config.ts rejects
# relative). Lives under the unit's StateDirectory= dir. If you
# override this in the operator env file, the new path must be
# inside the unit's ReadWritePaths (StateDirectory + CacheDirectory
# by default, or whatever a `ReadWritePaths=` drop-in adds);
# anywhere else fails opaquely with EACCES because the unit sets
# ProtectSystem=strict.
SQLITE_PATH=/var/lib/vigario-website/quotes.db

# SMTP — quote submissions are best-effort emailed; empty values
# disable the email path entirely. Set in the operator override file
# to enable.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Sentry server-side DSN. Empty disables server reporting. Set in
# the operator override file to enable.
SENTRY_DSN=
