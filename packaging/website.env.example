# tylervigario-website runtime environment.
# Installed at /etc/tylervigario-website/website.env (%config noreplace).
# Edited in place by the operator; not overwritten by package upgrades.

# Bind address (server.ts default is 127.0.0.1; Apache reverse-proxies).
HOSTNAME=127.0.0.1
PORT=3000

# SQLite database path. Must be absolute (runtime-config.ts rejects relative).
# Lives under StateDirectory= (/var/lib/tylervigario-website), owned by website:website.
SQLITE_PATH=/var/lib/tylervigario-website/quotes.db

# SMTP — quote submissions are best-effort emailed; missing values disable.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Sentry server-side DSN. Empty disables server reporting.
SENTRY_DSN=
