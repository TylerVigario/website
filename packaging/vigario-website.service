[Unit]
Description=tylervigario.com — Vigario Technology Solutions marketing site
Documentation=https://github.com/TylerVigario/website
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
User=website
Group=website
WorkingDirectory=/usr/share/vigario-website
# Versioned binary on purpose. `/usr/bin/node` is whatever Fedora's
# unversioned `nodejs` package decided is the system default — on F43
# that's v22. The package's Requires: nodejs24 ensures node-24 exists.
ExecStart=/usr/bin/node-24 server.js
Restart=always
RestartSec=5

# Canonical defaults shipped by the RPM at /usr/lib/<pkg>/default.env
# (read-only). Operator overrides at /etc/sysconfig/<pkg> (optional,
# not RPM-owned) load AFTER and win — standard systemd "later file
# overrides earlier" semantics. The `-` on the second line makes it
# optional, so the unit starts cleanly on hosts where the operator
# hasn't created the override file.
EnvironmentFile=/usr/lib/vigario-website/default.env
EnvironmentFile=-/etc/sysconfig/vigario-website
Environment=NODE_ENV=production
Environment=HOME=/var/lib/vigario-website

# State + cache live outside /usr (read-only under ProtectSystem=strict).
# StateDirectory= and CacheDirectory= create /var/lib/<pkg> and
# /var/cache/<pkg> at unit-start with correct ownership and add both
# to ReadWritePaths automatically. The tmpfiles.d config is a
# backstop for boot ordering.
StateDirectory=vigario-website
CacheDirectory=vigario-website

# Filesystem hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RemoveIPC=true

# Kernel hardening
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true

# Process hardening
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# Hide other-user processes — the website uid has no reason to see
# root-owned or sshd-owned PIDs. ProcSubset=pid is deliberately NOT
# set: libuv reads /proc/cpuinfo for os.cpus() and
# uv_resident_set_memory(); ProcSubset=pid would make both silently
# return empty/wrong values. Don't "complete the hardening" by adding
# it back.
ProtectProc=invisible

# Syscall filtering — @chown allowed because libuv's copyfile uses fchown.
SystemCallArchitectures=native
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@privileged
SystemCallFilter=@chown

CapabilityBoundingSet=
AmbientCapabilities=

MemoryMax=1G
TasksMax=100

[Install]
WantedBy=multi-user.target
