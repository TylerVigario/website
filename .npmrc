# Nothing is installed until it has been public for a week. A hijacked
# publish is usually caught and pulled within days, and a week costs
# nothing on a site with no feature waiting on a dependency.
#
# npm enforces it (11.10 and later) on every resolve in this repository:
# `npm install`, `npm update`, by a person or an agent. `npm ci` installs
# the lockfile as it is, so CI and the release are unaffected. Dependabot
# takes it as the floor of its cooldown (.github/dependabot.yml) and skips
# it for security updates, which are not held back. npm has one window
# for every version, so a major waits two weeks only through Dependabot.
min-release-age=7
